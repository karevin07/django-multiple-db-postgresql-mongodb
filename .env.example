# Copy to .env and edit. These are throwaway values for a local-only stack;
# pick real passwords before exposing any of these services.

# Django
SECRET_KEY='django-insecure-dev-only-change-me'
DEBUG=1
ALLOWED_HOSTS='localhost,127.0.0.1,0.0.0.0'

# PostgreSQL
POSTGRES_NAME='user_data'
POSTGRES_USER='app'
POSTGRES_PASSWORD='dev-only-change-me'
POSTGRES_PORT=5432

# MongoDB
MONGO_ROOT_USER='app'
MONGO_ROOT_PASSWORD='dev-only-change-me'
MONGO_PORT=27017
MONGO_DATABASE='app_data'

# pgAdmin (web UI, http://127.0.0.1:5050)
PGADMIN_DEFAULT_EMAIL='admin@example.com'
PGADMIN_DEFAULT_PASSWORD='dev-only-change-me'

# mongo-express (web UI, http://127.0.0.1:8081) - HTTP basic auth
MONGOEXPRESS_LOGIN='admin'
MONGOEXPRESS_PASSWORD='dev-only-change-me'

# When running Django outside Docker Compose, point these at your local services:
# POSTGRES_HOST=127.0.0.1
# MONGO_HOST=127.0.0.1
